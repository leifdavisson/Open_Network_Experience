# Open Network Experience (ONE) — Environment Configuration Template
# Copy this file to .env and populate with your deployment values.
# NEVER commit your actual .env file to version control.

# ─────────────────────────────────────────────────────────
# CMP Control Plane
# ─────────────────────────────────────────────────────────

# Hostname or IP address of the CMP server (used by gateway/bandwidth probes)
CMP_HOST="cmp.example.edu"

# Port the CMP HTTP API listens on
CMP_PORT="8000"

# Admin API key for the CMP REST API — change before production deployment
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY="change-me-before-production"

# ─────────────────────────────────────────────────────────
# Edge Sensor SSH Delegation (on-demand diagnostics)
# ─────────────────────────────────────────────────────────

# SSH username on edge sensor appliances
SSH_USER="sensor"

# SSH password for on-demand diagnostic delegation.
# If empty, SSH delegation is disabled (CMP-side fallback probes are used).
# Prefer SSH key-based auth in production (leave SSH_PASS empty, configure authorized_keys).
SSH_PASS=""

# ─────────────────────────────────────────────────────────
# Lab / Development Overrides (NOT for production)
# ─────────────────────────────────────────────────────────

# Lab bench CMP server address (dev/staging only)
# CMP_HOST="10.98.2.125"

# Lab bench sensor address (dev/staging only)
# SENSOR_HOST="10.98.2.105"

# Lab bench credentials (dev/staging only — never use in production)
# SSH_USER="kern"
# SSH_PASS="YourPasswordHere"
